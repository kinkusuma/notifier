generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ChannelType {
  EMAIL
  TELEGRAM
  WHATSAPP
  WEBHOOK
  PUSH
  IN_APP
}

enum NotificationStatus {
  SCHEDULED
  QUEUED
  PROCESSING
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
  FALLBACK_TRIGGERED
}

enum Priority {
  HIGH
  NORMAL
  LOW
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id                 String              @id @default(uuid())
  externalId         String              @unique
  email              String?
  phoneNumber        String?
  telegramChatId     String?
  webhookUrl         String?
  fcmTokens          String[]            @default([])
  metadata           Json?
  preferences        UserPreference[]
  logs               NotificationLog[]
  inAppNotifications InAppNotification[]
  digests            NotificationDigest[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Template {
  id              String       @id @default(uuid())
  slug            String       @unique
  title           String
  subject         String?
  bodyText        String
  bodyHtml        String?
  defaultChannel  ChannelType
  fallbackChannel ChannelType?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model UserPreference {
  id           String      @id @default(uuid())
  subscriberId String
  channel      ChannelType
  category     String      @default("DEFAULT")
  isEnabled    Boolean     @default(true)
  subscriber   Subscriber  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([subscriberId, channel, category])
}

model InAppNotification {
  id           String     @id @default(uuid())
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  title        String
  message      String
  data         Json?
  isRead       Boolean    @default(false)
  readAt       DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([subscriberId, isRead])
  @@index([createdAt])
}

model NotificationDigest {
  id           String      @id @default(uuid())
  subscriberId String
  subscriber   Subscriber  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  category     String      @default("DEFAULT")
  templateSlug String
  channel      ChannelType
  items        Json
  expiresAt    DateTime
  status       String      @default("BUFFERING")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([subscriberId, category, status])
}

model NotificationLog {
  id           String             @id @default(uuid())
  subscriberId String
  subscriber   Subscriber         @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  templateSlug String
  channel      ChannelType
  provider     String
  recipient    String
  subject      String?
  content      String
  status       NotificationStatus @default(QUEUED)
  errorMessage String?
  retriesCount Int                @default(0)
  messageId    String?
  parentLogId  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([subscriberId])
  @@index([status])
  @@index([templateSlug])
  @@index([messageId])
}
