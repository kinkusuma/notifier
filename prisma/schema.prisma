generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ChannelType {
  EMAIL
  TELEGRAM
  WHATSAPP
  WEBHOOK
  PUSH
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  DELIVERED
  FAILED
  FALLBACK_TRIGGERED
}

enum Priority {
  HIGH
  NORMAL
  LOW
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id             String            @id @default(uuid())
  externalId     String            @unique
  email          String?
  phoneNumber    String?
  telegramChatId String?
  webhookUrl     String?
  fcmTokens      String[]          @default([])
  metadata       Json?
  preferences    UserPreference[]
  logs           NotificationLog[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Template {
  id              String       @id @default(uuid())
  slug            String       @unique
  title           String
  subject         String?
  bodyText        String
  bodyHtml        String?
  defaultChannel  ChannelType
  fallbackChannel ChannelType?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model UserPreference {
  id           String      @id @default(uuid())
  subscriberId String
  channel      ChannelType
  category     String      @default("DEFAULT")
  isEnabled    Boolean     @default(true)
  subscriber   Subscriber  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([subscriberId, channel, category])
}

model NotificationLog {
  id           String             @id @default(uuid())
  subscriberId String
  subscriber   Subscriber         @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  templateSlug String
  channel      ChannelType
  provider     String
  recipient    String
  subject      String?
  content      String
  status       NotificationStatus @default(QUEUED)
  errorMessage String?
  retriesCount Int                @default(0)
  messageId    String?
  parentLogId  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([subscriberId])
  @@index([status])
  @@index([templateSlug])
}
